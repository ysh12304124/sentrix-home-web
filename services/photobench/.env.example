# Copy to .env.local on each evaluation host. .env.local is gitignored.
# These values override config/runtime_connection.json. An empty
# BENCH_VLLM_API_URL means this host has no vLLM Manager.
# Do not put another machine's LAN address here.
BENCH_SENTRIX_URL=http://127.0.0.1:8091
BENCH_VLLM_API_URL=
BENCH_VLLM_BASE_URL=http://127.0.0.1:8100/v1
# BENCH_JUDGE_API_KEY=
