# Copy this file to .env.local and replace the model paths for this computer.
SENTRIX_API_PORT=8090
PORT=4174
PHOTOBENCH_PORT=8772
LOCAL_QWEN_PORT=11434
LOCAL_QWEN_MODEL_NAME=Qwen3-VL-4B-Instruct
LOCAL_QWEN_MODEL_PATH=D:\path\to\Qwen3-VL-4B-Instruct
LOCAL_QWEN_IDLE_UNLOAD_SECONDS=60
LOCAL_BGE_MODEL_PATH=D:\path\to\bge-m3
SENTRIX_RERANKER_ENABLED=true
SENTRIX_RERANKER_MODEL_PATH=D:\path\to\bge-reranker-v2-m3
SENTRIX_RERANKER_DEVICE=auto
SENTRIX_RERANKER_BATCH_SIZE=8
SENTRIX_RERANKER_MAX_LENGTH=512
SENTRIX_RERANKER_IDLE_UNLOAD_SECONDS=60
SENTRIX_RERANKER_CLUSTER_WINDOW_SECONDS=1
SENTRIX_RERANKER_COARSE_RANK_WEIGHT=1
SENTRIX_RERANKER_BGE_RANK_WEIGHT=0.1
SENTRIX_RERANKER_FUSION_RRF_K=60
SENTRIX_RERANKER_SKIP_WHOLE_VIDEO_ONLY=true
SENTRIX_RERANK_HEAD=50
SENTRIX_SLOT_ROUTE_HEAD=50
SENTRIX_SEARCH_CANDIDATE_TOP_K=50
# Optional richer named-vector collection migrated from Sentrix Lite.
# The main API reads it directly; port 8091 is not required.
SENTRIX_LITE_NAMED_VECTOR_PATH=D:\path\to\.sentrix-lite\qdrant
SENTRIX_LITE_NAMED_VECTOR_COLLECTION=sentrix_memory_units_v1
SENTRIX_LITE_NAMED_VECTOR_SCOPE_ID=scope_xxx
CLIP_CHECKPOINT=C:\path\to\ViT-B-32.pt
CLIP_DEVICE=cpu
FACE_ENABLED=false
