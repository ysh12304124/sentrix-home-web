SENTRIX_VIDEO_KEYFRAME_ALGORITHM=hybrid_webp
SENTRIX_VIDEO_SAMPLE_FPS=10
SENTRIX_VIDEO_YOLO_BATCH_SIZE=16
SENTRIX_VIDEO_TARGET_DECODE_WORKERS=4
SENTRIX_VIDEO_WEBP_QUALITY=80
SENTRIX_VIDEO_TIMEOUT_SECONDS=7200
